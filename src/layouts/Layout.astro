---
import "../styles/global.css";
import MenuDrawer from "@/components/MenuDrawer.astro";

const { title = "Lucky Ivanius — Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Lucky Ivanius — Software Engineer" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <MenuDrawer />
  </body>
</html>

<script>
  import Lenis from "lenis";

  // Lenis keeps the browser's native scroll position and only interpolates it,
  // so scroll-driven code (the hero parallax and marquee) keeps working as-is.
  // `respectReducedMotion` is on by default, which skips smoothing for users
  // who ask for less motion.
  const lenis = new Lenis({
    autoRaf: true,
    // The nav links are hash anchors, so let Lenis glide to them too.
    anchors: true,
    // Cut the glide short when a link starts navigating to another page.
    stopInertiaOnNavigate: true,
  });

  // Overlays (the floating menu drawer) pause smoothing while they're open.
  window.__lenis = lenis;
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
