---
const description =
  "I'm a software engineer with 6+ years of experience building software end-to-end.";
---

<section
  id="about"
  class="dark relative isolate flex w-full items-center border-t border-border bg-background px-8 py-32"
  aria-label="About"
>
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-8">
    <p
      data-about-eyebrow
      class="text-sm uppercase tracking-[0.2em] text-muted-foreground font-mono"
    >
      About
    </p>

    <p class="grid max-w-5xl text-4xl leading-tight text-foreground font-heading md:text-5xl">
      <!-- Screen-reader copy: the sentence is announced once, in full, even
           while the visible copy is still typing. -->
      <span class="sr-only">{description}</span>

      <!-- Invisible sizer in the same grid cell holds the finished height, so
           the block never reflows while the visible copy types in. -->
      <span class="invisible col-start-1 row-start-1" aria-hidden="true">
        {description}
      </span>

      <span class="col-start-1 row-start-1" aria-hidden="true">
        <span data-about-text>{description}</span>
        <span data-about-cursor></span>
      </span>
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!prefersReducedMotion) {
    const section = document.querySelector<HTMLElement>("#about");
    const eyebrow = section?.querySelector<HTMLElement>("[data-about-eyebrow]");
    const text = section?.querySelector<HTMLElement>("[data-about-text]");
    const cursor = section?.querySelector<HTMLElement>("[data-about-cursor]");

    if (section && eyebrow && text && cursor) {
      // The sentence ships in the markup for no-JS and reduced-motion users;
      // read it before the visible copy is emptied, and normalize whitespace so
      // the typing is driven by characters, not by the template's line breaks.
      const sentence = (text.textContent ?? "").replace(/\s+/g, " ").trim();

      text.textContent = "";
      gsap.set(eyebrow, { autoAlpha: 0, y: 12 });

      // Typed by character index: GSAP tweens the count and each update writes
      // the matching slice. `snap` keeps it to whole letters rather than
      // sub-pixel partials.
      const typing = { chars: 0 };

      gsap
        .timeline({
          // `once` plays the reveal as the section enters view and then tears
          // the trigger down, so scrolling back up never replays or reverses it.
          scrollTrigger: { trigger: section, start: "top 65%", once: true },
        })
        .to(eyebrow, { autoAlpha: 1, y: 0, duration: 0.5, ease: "power2.out" })
        .set(cursor, { autoAlpha: 1 }, "-=0.1")
        .to(typing, {
          chars: sentence.length,
          duration: 1.8,
          ease: "none",
          snap: { chars: 1 },
          onUpdate: () => {
            text.textContent = sentence.slice(0, typing.chars);
          },
        })
        // Hand the cursor over to its blinking loop once the last letter lands.
        .add(() => cursor.classList.add("is-done"));
    }

    // Text metrics decide the section's height, and therefore where the trigger
    // sits, so re-measure once the heading font has loaded.
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }
</script>

<style>
  [data-about-cursor] {
    display: inline-block;
    width: 0.06em;
    height: 0.78em;
    margin-left: 0.08em;
    vertical-align: -0.06em;
    background: var(--primary);
    opacity: 0;
  }

  [data-about-cursor].is-done {
    animation: about-cursor-pulse 1s step-end infinite;
  }

  @keyframes about-cursor-pulse {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>
